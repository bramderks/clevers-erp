/// ======================================================
/// INSTELLINGEN
/// ======================================================

enum StatusModule {
  MEDEWERKER
  BESTELLING
  LEVERING
  VOORRAAD
  PLANNING
}

model Status {
  id String @id @default(cuid())

  /// =====================================================
  /// Algemeen
  /// =====================================================

  module StatusModule

  code String

  naam String

  omschrijving String?

  /// =====================================================
  /// Weergave
  /// =====================================================

  kleur String?

  icoon String?

  cssClass String?

  volgorde Int @default(0)

  actief Boolean @default(true)

  /// =====================================================
  /// Relaties
  /// =====================================================

  medewerkers Medewerker[]

  bestellingen Bestelling[]

  voorraadTellingen VoorraadTelling[]

  /// =====================================================
  /// Audit
  /// =====================================================

  aangemaaktOp DateTime @default(now())
  gewijzigdOp DateTime @updatedAt

  @@unique([module, code])

  @@index([module])
  @@index([actief])
  @@index([volgorde])
}

model Instelling {
  id String @id @default(cuid())

  sleutel String @unique

  waarde String

  omschrijving String?

  categorie String?

  aangemaaktOp DateTime @default(now())
  gewijzigdOp DateTime @updatedAt

  @@index([categorie])
}