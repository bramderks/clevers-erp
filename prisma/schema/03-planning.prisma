/// ======================================================
/// PERSONEELSPLANNING
/// ======================================================

/// ======================================================
/// TAGS
/// ======================================================

model Tag {
  id String @id @default(cuid())

  naam String @unique

  volgorde Int @default(0)

  actief Boolean @default(true)

  medewerkers MedewerkerTag[]
  diensten DienstTag[]

  aangemaaktOp DateTime @default(now())
  gewijzigdOp DateTime @updatedAt

  @@index([volgorde])
  @@index([actief])
}

/// ======================================================
/// MEDEWERKER - TAG
/// ======================================================

model MedewerkerTag {
  id String @id @default(cuid())

  medewerkerId String
  tagId String

  medewerker Medewerker @relation(fields: [medewerkerId], references: [id], onDelete: Cascade)
  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([medewerkerId, tagId])

  @@index([medewerkerId])
  @@index([tagId])
}

/// ======================================================
/// WEEK
/// ======================================================

model Week {
  id String @id @default(cuid())

  vestigingId String

  jaar Int
  weeknummer Int

  /// -----------------------------------------------------
  /// Status
  ///
  /// OPEN
  /// IN_PLANNING
  /// GEPUBLICEERD
  /// AFGESLOTEN
  /// -----------------------------------------------------

  status String @default("OPEN")

  /// -----------------------------------------------------
  /// Beschikbaarheidsdeadline
  ///
  /// Uiterste moment waarop medewerkers hun
  /// beschikbaarheid voor deze week kunnen doorgeven.
  ///
  /// De daadwerkelijke deadline wordt per week
  /// opgeslagen zodat historische weken hun oorspronkelijke
  /// deadline behouden.
  /// -----------------------------------------------------

  beschikbaarheidDeadline DateTime?

  vestiging Vestiging @relation(fields: [vestigingId], references: [id], onDelete: Cascade)

  diensten Dienst[]
  beschikbaarheden Beschikbaarheid[]

  aangemaaktOp DateTime @default(now())
  gewijzigdOp DateTime @updatedAt

  @@unique([vestigingId, jaar, weeknummer])

  @@index([vestigingId])
  @@index([jaar, weeknummer])
  @@index([status])
  @@index([beschikbaarheidDeadline])
}

/// ======================================================
/// BESCHIKBAARHEID
///
/// De normale wekelijkse beschikbaarheid van een
/// medewerker voor de personeelsplanning.
///
/// Dit model is NIET bedoeld voor vakantie of langere
/// afwezigheid. Daarvoor bestaat VakantieAanvraag.
/// ======================================================

model Beschikbaarheid {
  id String @id @default(cuid())

  weekId String
  medewerkerId String

  datum DateTime

  begintijd DateTime?
  eindtijd DateTime?

  /// -----------------------------------------------------
  /// Beschikbaarheidsstatus
  ///
  /// BESCHIKBAAR
  /// NIET_BESCHIKBAAR
  /// VOORKEUR
  /// -----------------------------------------------------

  status String @default("BESCHIKBAAR")

  opmerking String?

  week Week @relation(fields: [weekId], references: [id], onDelete: Cascade)
  medewerker Medewerker @relation(fields: [medewerkerId], references: [id], onDelete: Cascade)

  aangemaaktOp DateTime @default(now())
  gewijzigdOp DateTime @updatedAt

  @@index([weekId])
  @@index([medewerkerId])
  @@index([datum])
  @@index([status])

  @@unique([weekId, medewerkerId, datum])
}

/// ======================================================
/// VAKANTIE / AFWEZIGHEID
///
/// Een vakantieaanvraag staat los van de normale
/// wekelijkse beschikbaarheid.
///
/// De medewerker kan hiermee een langere periode van
/// afwezigheid aanvragen.
///
/// De eigenaar beoordeelt de aanvraag.
///
/// Status:
///
/// AANGEVRAAGD
/// GOEDGEKEURD
/// AFGEWEZEN
/// GEANNULEERD
/// ------------------------------------------------------
///
/// Voor juni, juli en augustus geldt:
/// - maximaal 14 dagen aaneengesloten afwezigheid zonder
///   expliciete vakantieaanvraag;
/// - langere afwezigheid moet via dit model worden
///   aangevraagd.
/// ------------------------------------------------------
///
/// De daadwerkelijke beleidscontrole gebeurt in de
/// applicatielogica. Het model bewaart de aanvraag en
/// de uiteindelijke beslissing.
/// ======================================================

model VakantieAanvraag {
  id String @id @default(cuid())

  medewerkerId String
  vestigingId String

  startDatum DateTime
  eindDatum DateTime

  /// -----------------------------------------------------
  /// Type afwezigheid
  ///
  /// VAKANTIE
  /// OVERIG
  /// -----------------------------------------------------

  type String @default("VAKANTIE")

  opmerking String?

  /// -----------------------------------------------------
  /// Status
  ///
  /// AANGEVRAAGD
  /// GOEDGEKEURD
  /// AFGEWEZEN
  /// GEANNULEERD
  /// -----------------------------------------------------

  status String @default("AANGEVRAAGD")

  /// -----------------------------------------------------
  /// Beoordeling door eigenaar
  /// -----------------------------------------------------

  beoordeeldDoorId String?
  beoordeeldOp DateTime?

  redenAfwijzing String?

  aangevraagdOp DateTime @default(now())

  medewerker Medewerker @relation(fields: [medewerkerId], references: [id], onDelete: Cascade)
  vestiging Vestiging @relation(fields: [vestigingId], references: [id], onDelete: Restrict)

  aangemaaktOp DateTime @default(now())
  gewijzigdOp DateTime @updatedAt

  @@index([medewerkerId])
  @@index([vestigingId])
  @@index([startDatum])
  @@index([eindDatum])
  @@index([status])
  @@index([beoordeeldDoorId])
}

/// ======================================================
/// DIENST
/// ======================================================

model Dienst {
  id String @id @default(cuid())

  weekId String

  datum DateTime

  begintijd DateTime
  eindtijd DateTime

  opmerkingen String?

  week Week @relation(fields: [weekId], references: [id], onDelete: Cascade)

  tags DienstTag[]
  bezetting DienstBezetting[]

  aangemaaktOp DateTime @default(now())
  gewijzigdOp DateTime @updatedAt

  @@index([weekId])
  @@index([datum])
}

/// ======================================================
/// DIENST - TAG
/// ======================================================

model DienstTag {
  id String @id @default(cuid())

  dienstId String
  tagId String

  aantal Int @default(1)

  dienst Dienst @relation(fields: [dienstId], references: [id], onDelete: Cascade)
  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([dienstId, tagId])

  @@index([dienstId])
  @@index([tagId])
}

/// ======================================================
/// DIENST - BEZETTING
///
/// Dit is de daadwerkelijke planning.
///
/// medewerkerId blijft optioneel zodat een open
/// dienstplek kan bestaan voordat deze wordt ingevuld.
///
/// Status:
///
/// OPEN
/// GEPLAND
/// BEVESTIGD
/// AFGEZEGD
/// GEWERKT
/// ======================================================

model DienstBezetting {
  id String @id @default(cuid())

  dienstId String

  medewerkerId String?

  status String @default("OPEN")

  dienst Dienst @relation(fields: [dienstId], references: [id], onDelete: Cascade)
  medewerker Medewerker? @relation(fields: [medewerkerId], references: [id], onDelete: SetNull)

  urenregistratie UrenRegistratie?

  ruilverzoeken Ruilverzoek[]

  aangemaaktOp DateTime @default(now())
  gewijzigdOp DateTime @updatedAt

  @@index([dienstId])
  @@index([medewerkerId])
  @@index([status])

  @@unique([dienstId, medewerkerId])
}

/// ======================================================
/// DIENST RUILVERZOEK
///
/// Een medewerker kan zijn/haar eigen dienst aanbieden
/// aan een andere medewerker.
///
/// Flow:
///
/// AANGEVRAAGD
///       ↓
/// WACHT_OP_EIGENAAR
///       ↓
/// UITGEVOERD
///
/// De aangewezen medewerker moet eerst accepteren.
/// Daarna krijgt de eigenaar een controleactie.
///
/// Pas na goedkeuring door de eigenaar wordt de
/// DienstBezetting daadwerkelijk overgezet naar de
/// andere medewerker.
/// ======================================================

model Ruilverzoek {
  id String @id @default(cuid())

  dienstBezettingId String

  /// Medewerker die de ruil aanvraagt.
  aanvragerId String

  /// Medewerker die de dienst moet overnemen.
  ruilMedewerkerId String

  /// -----------------------------------------------------
  /// Ruilstatus
  ///
  /// AANGEVRAAGD
  /// AFGEWEZEN_DOOR_MEDEWERKER
  /// WACHT_OP_EIGENAAR
  /// AFGEWEZEN_DOOR_EIGENAAR
  /// GOEDGEKEURD
  /// UITGEVOERD
  /// -----------------------------------------------------

  status String @default("AANGEVRAAGD")

  aangevraagdOp DateTime @default(now())

  medewerkerGeaccepteerdOp DateTime?

  /// ID van de systeemgebruiker/eigenaar die de ruil
  /// heeft beoordeeld.
  ///
  /// Bewust alleen als ID opgeslagen. Hierdoor is voor
  /// deze relatie geen wijziging in SysteemGebruiker nodig.
  eigenaarBeoordeeldDoorId String?

  eigenaarBeoordeeldOp DateTime?

  uitgevoerdOp DateTime?

  dienstBezetting DienstBezetting @relation(fields: [dienstBezettingId], references: [id], onDelete: Cascade)

  aanvrager Medewerker @relation("RuilverzoekenAangevraagd", fields: [aanvragerId], references: [id], onDelete: Cascade)

  ruilMedewerker Medewerker @relation("RuilverzoekenOntvangen", fields: [ruilMedewerkerId], references: [id], onDelete: Cascade)

  aangemaaktOp DateTime @default(now())
  gewijzigdOp DateTime @updatedAt

  @@index([dienstBezettingId])
  @@index([aanvragerId])
  @@index([ruilMedewerkerId])
  @@index([status])
  @@index([eigenaarBeoordeeldDoorId])
}

/// ======================================================
/// URENREGISTRATIE
///
/// De urenregistratie bevat uitsluitend de daadwerkelijk
/// gewerkte uren.
///
/// Planning is nooit de definitieve bron voor gewerkte
/// uren.
///
/// Na afloop van een dienst controleert de eigenaar de
/// werkelijke begin- en eindtijd en legt deze definitief
/// vast.
///
/// Tijden worden technisch in stappen van 15 minuten
/// verwerkt.
///
/// Status:
///
/// TE_CONTROLEREN
/// DEFINITIEF
/// AFGEKEURD
/// ======================================================

model UrenRegistratie {
  id String @id @default(cuid())

  dienstBezettingId String
  medewerkerId String

  /// Vestiging wordt bewust als ID opgeslagen zodat de
  /// definitieve registratie altijd aan de betreffende
  /// vestiging gekoppeld blijft.
  vestigingId String

  datum DateTime

  /// Taak/functie waarvoor de medewerker heeft gewerkt.
  taak String?

  /// Werkelijke gewerkte tijden.
  werkelijkeBegintijd DateTime
  werkelijkeEindtijd DateTime

  /// Pauze in minuten.
  pauzeMinuten Int @default(0)

  /// Definitief berekende gewerkte uren.
  gewerkteUren Decimal @db.Decimal(5, 2)

  /// -----------------------------------------------------
  /// Status
  ///
  /// TE_CONTROLEREN
  /// DEFINITIEF
  /// AFGEKEURD
  /// -----------------------------------------------------

  status String @default("TE_CONTROLEREN")

  /// Systeemgebruiker die de uren heeft gecontroleerd.
  gecontroleerdDoorId String?

  gecontroleerdOp DateTime?

  opmerking String?

  dienstBezetting DienstBezetting @relation(fields: [dienstBezettingId], references: [id], onDelete: Cascade)

  medewerker Medewerker @relation(fields: [medewerkerId], references: [id], onDelete: Cascade)

  vestiging Vestiging @relation(fields: [vestigingId], references: [id], onDelete: Restrict)

  aangemaaktOp DateTime @default(now())
  gewijzigdOp DateTime @updatedAt

  @@unique([dienstBezettingId])

  @@index([medewerkerId])
  @@index([vestigingId])
  @@index([datum])
  @@index([status])
  @@index([gecontroleerdDoorId])
}