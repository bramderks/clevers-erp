/// ======================================================
/// MEDEWERKERS
/// ======================================================

enum Aanhef {
  DHR
  MEVR
  ANDERS
  GEEN_OPGAVE
}

enum ContractType {
  OPROEP
  VAST
}

/// ======================================================
/// MEDEWERKER
/// ======================================================

model Medewerker {
  id String @id @default(cuid())

  systeemGebruikerId String? @unique
  systeemGebruiker SysteemGebruiker? @relation(fields: [systeemGebruikerId], references: [id], onDelete: SetNull)

  personeelsnummer String? @unique

  aanhef Aanhef

  voornaam String
  tussenvoegsel String?
  achternaam String
  roepnaam String?

  geboortedatum DateTime

  email String @unique
  telefoon String

  statusId String
  status Status @relation(fields: [statusId], references: [id], onDelete: Restrict)

  aanmeldingOp DateTime @default(now())

  geactiveerdOp DateTime?
  geactiveerdDoor String?

  actief Boolean @default(false)

  contractType ContractType?
  contractUren Decimal? @db.Decimal(5, 2)
  uurloon Decimal? @db.Decimal(8, 2)

  datumInDienst DateTime?
  datumUitDienst DateTime?

  vestigingen MedewerkerVestiging[]
  vakantieAanvragen VakantieAanvraag[]

  rollen MedewerkerRol[]
  tags MedewerkerTag[]

  beschikbaarheden Beschikbaarheid[]
  diensten DienstBezetting[]
  urenregistraties UrenRegistratie[]

  verloningsRegels VerloningsRegel[]

  ruilverzoekenAangevraagd Ruilverzoek[] @relation("RuilverzoekenAangevraagd")
  ruilverzoekenOntvangen Ruilverzoek[] @relation("RuilverzoekenOntvangen")

  aangemaaktOp DateTime @default(now())
  gewijzigdOp DateTime @updatedAt

  @@index([statusId])
  @@index([actief])
  @@index([achternaam])
  @@index([voornaam])
}

model MedewerkerVestiging {
  id String @id @default(cuid())

  medewerkerId String
  vestigingId String

  hoofdvestiging Boolean @default(false)

  medewerker Medewerker @relation(fields: [medewerkerId], references: [id], onDelete: Cascade)
  vestiging Vestiging @relation(fields: [vestigingId], references: [id], onDelete: Cascade)

  aangemaaktOp DateTime @default(now())

  @@unique([medewerkerId, vestigingId])
  @@index([medewerkerId])
  @@index([vestigingId])
}

model MedewerkerRol {
  id String @id @default(cuid())

  medewerkerId String
  rolId String

  medewerker Medewerker @relation(fields: [medewerkerId], references: [id], onDelete: Cascade)
  rol Rol @relation(fields: [rolId], references: [id], onDelete: Cascade)

  aangemaaktOp DateTime @default(now())

  @@unique([medewerkerId, rolId])
  @@index([medewerkerId])
  @@index([rolId])
}