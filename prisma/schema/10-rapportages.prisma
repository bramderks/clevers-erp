/// ======================================================
/// RAPPORTAGES
/// ======================================================

/// ======================================================
/// VERLONINGSPERIODE
/// ======================================================

model VerloningsPeriode {
  id String @id @default(cuid())

  periodeStart DateTime
  periodeEinde DateTime

  jaar Int
  maand Int

  status String @default("AANGEMAAKT")

  gegenereerdOp DateTime?

  controleStart DateTime?
  controleDeadline DateTime?

  gecontroleerdDoorId String?
  gecontroleerdOp DateTime?

  regels VerloningsRegel[]
  controles VerloningsControle[]

  aangemaaktOp DateTime @default(now())
  gewijzigdOp DateTime @updatedAt

  @@unique([jaar, maand])
  @@index([jaar, maand])
  @@index([status])
  @@index([periodeStart])
  @@index([periodeEinde])
  @@index([controleStart])
  @@index([controleDeadline])
  @@index([gecontroleerdDoorId])
}

model VerloningsControle {
  id String @id @default(cuid())

  verloningsPeriodeId String
  medewerkerId String

  verloningsPeriode VerloningsPeriode @relation(fields: [verloningsPeriodeId], references: [id], onDelete: Cascade)
  medewerker Medewerker @relation(fields: [medewerkerId], references: [id], onDelete: Cascade)

  status String @default("OPEN")

  gecontroleerdOp DateTime?
  automatischAkkoordOp DateTime?

  aangemaaktOp DateTime @default(now())
  gewijzigdOp DateTime @updatedAt

  @@unique([verloningsPeriodeId, medewerkerId])
  @@index([verloningsPeriodeId])
  @@index([medewerkerId])
  @@index([status])
  @@index([verloningsPeriodeId, status])
}

model VerloningsRegel {
  id String @id @default(cuid())

  verloningsPeriodeId String
  medewerkerId String
  vestigingId String

  medewerkerNaam String
  gewerkteDagen Int @default(0)
  gewerkteUren Decimal @db.Decimal(7, 2)

  /// Snapshot van het uurloon op het moment van verloning.
  /// Dit blijft historisch correct als het huidige uurloon later wijzigt.
  uurloon Decimal? @db.Decimal(8, 2)

  /// Snapshot van de loonkosten van deze verloningsregel.
  loonkosten Decimal? @db.Decimal(12, 2)

  verloningsPeriode VerloningsPeriode @relation(fields: [verloningsPeriodeId], references: [id], onDelete: Cascade)
  medewerker Medewerker @relation(fields: [medewerkerId], references: [id], onDelete: Restrict)
  vestiging Vestiging @relation(fields: [vestigingId], references: [id], onDelete: Restrict)

  aangemaaktOp DateTime @default(now())
  gewijzigdOp DateTime @updatedAt

  @@unique([verloningsPeriodeId, medewerkerId, vestigingId])
  @@index([verloningsPeriodeId])
  @@index([medewerkerId])
  @@index([vestigingId])
  @@index([vestigingId, medewerkerNaam])
}

/// Geplande loonkosten en omzet per planningweek.
/// Bij afsluiten wordt een volledige snapshot opgeslagen.
/// De snapshot verandert daarna nooit meer en vormt de historische bron.
model LoonkostenWeek {
  id String @id @default(cuid())

  weekId String @unique
  omzet Decimal @default(0) @db.Decimal(12, 2)
  doelPercentage Decimal @default(20) @db.Decimal(5, 2)

  totaalUren Decimal @default(0) @db.Decimal(10, 2)
  totaalKosten Decimal @default(0) @db.Decimal(12, 2)
  gemiddeldUurloon Decimal @default(0) @db.Decimal(8, 2)
  percentageOmzet Decimal? @db.Decimal(8, 2)

  /// Volledige bevroren weergave van dagen en medewerkers.
  snapshot Json?

  /// Definitief moment waarop deze weekrapportage is afgesloten.
  afgeslotenOp DateTime?
  afgeslotenDoorId String?

  week Week @relation(fields: [weekId], references: [id], onDelete: Cascade)

  aangemaaktOp DateTime @default(now())
  gewijzigdOp DateTime @updatedAt

  @@index([afgeslotenOp])
  @@index([afgeslotenDoorId])
}


/// ======================================================
/// HISTORISCHE VERLONING / BEDRIJFSCIJFERS
/// ======================================================
///
/// Losgekoppeld van de actuele planning. Deze records bevatten
/// uitsluitend historische KPI's/snapshots en nooit historische
/// medewerkers of diensten.
///
/// Daardoor blijven rapportages stabiel wanneer actuele planning,
/// medewerkers of lonen later wijzigen.
model HistorischeVerloningsPeriode {
  id String @id @default(cuid())

  vestigingId String
  vestiging Vestiging @relation(fields: [vestigingId], references: [id], onDelete: Cascade)

  periodeStart DateTime
  periodeEinde DateTime

  omschrijving String?
  jaar Int?
  weeknummer Int?

  /// Historische gemiddelde omzet zoals aangeleverd in de bron.
  gemiddeldeOmzet Decimal @db.Decimal(12, 2)

  /// Historische loonkosten zoals aangeleverd in de bron.
  loonkosten Decimal @db.Decimal(12, 2)

  /// Historisch percentage personeelskosten zoals vastgelegd in de bron.
  loonkostenPercentage Decimal? @db.Decimal(7, 3)

  /// Historisch gemiddeld uurloon; dit is een snapshot.
  gemiddeldUurloon Decimal? @db.Decimal(8, 2)

  /// Historische inzet in uren voor de volledige periode/week.
  weekUrenInzet Decimal? @db.Decimal(10, 2)

  /// Historische gemiddelde inzet per dag.
  dagUrenInzet Decimal? @db.Decimal(10, 2)

  /// Herkomst van de historische cijfers, bijvoorbeeld een Excel-import.
  bron String?

  vastgelegdOp DateTime @default(now())
  gewijzigdOp DateTime @updatedAt

  @@unique([vestigingId, periodeStart, periodeEinde])
  @@index([vestigingId, periodeStart])
  @@index([vestigingId, jaar, weeknummer])
  @@index([periodeStart, periodeEinde])
}
