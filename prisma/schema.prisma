generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// ======================================================
/// PLATFORM
/// ======================================================

model Vestiging {
  id String @id @default(cuid())

  code String @unique
  naam String @unique

  actief Boolean @default(true)

  aangemaaktOp DateTime @default(now())
  gewijzigdOp DateTime @updatedAt

  medewerkers MedewerkerVestiging[]

  weken Week[]
  bestellingen Bestelling[]
  voorraadTellingen VoorraadTelling[]
  voorraadMutaties VoorraadMutatie[]
  vestigingProducten VestigingProduct[]

  aangemaaktDoor String?
  gewijzigdDoor String?

  @@index([actief])
}

model Rol {
  id String @id @default(cuid())

  naam String @unique

  omschrijving String?

  medewerkerRollen MedewerkerRol[]

  systeemGebruikerRollen SysteemGebruikerRol[]

  aangemaaktOp DateTime @default(now())
  gewijzigdOp DateTime @updatedAt
}

model SysteemGebruiker {
  id String @id @default(cuid())

  naam String

  email String @unique

  wachtwoordHash String

  actief Boolean @default(true)

  laatsteLoginOp DateTime?

  rollen SysteemGebruikerRol[]

  auditLogs AuditLog[]

  aangemaaktOp DateTime @default(now())
  gewijzigdOp DateTime @updatedAt

  @@index([actief])
}

model SysteemGebruikerRol {
  id String @id @default(cuid())

  systeemGebruikerId String
  rolId String

  systeemGebruiker SysteemGebruiker @relation(fields: [systeemGebruikerId], references: [id], onDelete: Cascade)

  rol Rol @relation(fields: [rolId], references: [id], onDelete: Cascade)

  @@unique([systeemGebruikerId, rolId])
}

model AuditLog {
  id String @id @default(cuid())

  systeemGebruikerId String?

  systeemGebruiker SysteemGebruiker? @relation(fields: [systeemGebruikerId], references: [id], onDelete: SetNull)

  module String

  actie String

  recordId String?

  details Json?

  aangemaaktOp DateTime @default(now())

  @@index([module])

  @@index([aangemaaktOp])
}

/// ======================================================
/// MEDEWERKERS
/// ======================================================

enum Aanhef {
  DHR
  MEVR
  ANDERS
  GEEN_OPGAVE
}

enum ContractType {
  OPROEP
  TIJDELIJK
  VAST
  STAGIAIR
  VAKANTIEKRACHT
}

/// ======================================================
/// MEDEWERKER
/// ======================================================

model Medewerker {
  id String @id @default(cuid())

  /// -----------------------------------------------------
  /// Persoonlijke gegevens
  /// -----------------------------------------------------

  personeelsnummer String? @unique

  aanhef Aanhef

  voornaam String
  tussenvoegsel String?
  achternaam String
  roepnaam String?

  geboortedatum DateTime

  /// -----------------------------------------------------
  /// Contactgegevens
  /// -----------------------------------------------------

  email String @unique
  telefoon String

  /// -----------------------------------------------------
  /// Account en status
  /// -----------------------------------------------------

  wachtwoordHash String

  statusId String
  status Status @relation(fields: [statusId], references: [id], onDelete: Restrict)

  aanmeldingOp DateTime @default(now())

  geactiveerdOp DateTime?
  geactiveerdDoor String?

  actief Boolean @default(false)

  /// -----------------------------------------------------
  /// Dienstverband
  /// -----------------------------------------------------

  contractType ContractType?

  contractUren Decimal? @db.Decimal(5, 2)

  datumInDienst DateTime?
  datumUitDienst DateTime?

  /// -----------------------------------------------------
  /// Organisatie
  /// -----------------------------------------------------

  vestigingen MedewerkerVestiging[]

  /// -----------------------------------------------------
  /// Rollen en tags
  /// -----------------------------------------------------

  rollen MedewerkerRol[]
  tags MedewerkerTag[]

  /// -----------------------------------------------------
  /// Planning
  /// -----------------------------------------------------

  beschikbaarheden Beschikbaarheid[]
  diensten DienstBezetting[]

  /// -----------------------------------------------------
  /// Audit
  /// -----------------------------------------------------

  aangemaaktOp DateTime @default(now())
  gewijzigdOp DateTime @updatedAt

  /// -----------------------------------------------------
  /// Indexen
  /// -----------------------------------------------------

  @@index([statusId])
  @@index([actief])
  @@index([achternaam])
  @@index([voornaam])
}

/// ======================================================
/// MEDEWERKER - VESTIGING
/// ======================================================

model MedewerkerVestiging {
  id String @id @default(cuid())

  medewerkerId String
  vestigingId String

  hoofdvestiging Boolean @default(false)

  medewerker Medewerker @relation(fields: [medewerkerId], references: [id], onDelete: Cascade)
  vestiging Vestiging @relation(fields: [vestigingId], references: [id], onDelete: Cascade)

  aangemaaktOp DateTime @default(now())

  @@unique([medewerkerId, vestigingId])

  @@index([medewerkerId])
  @@index([vestigingId])
}

/// ======================================================
/// MEDEWERKER - ROL
/// ======================================================

model MedewerkerRol {
  id String @id @default(cuid())

  medewerkerId String
  rolId String

  medewerker Medewerker @relation(fields: [medewerkerId], references: [id], onDelete: Cascade)
  rol Rol @relation(fields: [rolId], references: [id], onDelete: Cascade)

  aangemaaktOp DateTime @default(now())

  @@unique([medewerkerId, rolId])

  @@index([medewerkerId])
  @@index([rolId])
}

/// ======================================================
/// PERSONEELSPLANNING
/// ======================================================

/// ======================================================
/// TAGS
/// ======================================================

model Tag {
  id String @id @default(cuid())

  naam String @unique

  volgorde Int @default(0)

  actief Boolean @default(true)

  medewerkers MedewerkerTag[]
  diensten DienstTag[]

  aangemaaktOp DateTime @default(now())
  gewijzigdOp DateTime @updatedAt

  @@index([volgorde])
  @@index([actief])
}

/// ======================================================
/// MEDEWERKER - TAG
/// ======================================================

model MedewerkerTag {
  id String @id @default(cuid())

  medewerkerId String
  tagId String

  medewerker Medewerker @relation(fields: [medewerkerId], references: [id], onDelete: Cascade)
  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([medewerkerId, tagId])

  @@index([medewerkerId])
  @@index([tagId])
}

/// ======================================================
/// WEEK
/// ======================================================

model Week {
  id String @id @default(cuid())

  vestigingId String

  jaar Int
  weeknummer Int

  /// OPEN
  /// IN_PLANNING
  /// GEPUBLICEERD
  /// AFGESLOTEN
  status String @default("OPEN")

  /// -----------------------------------------------------
  /// Beschikbaarheidsdeadline
  ///
  /// Tot en met dit moment mag een medewerker zijn/haar
  /// eigen beschikbaarheid toevoegen, wijzigen en verwijderen.
  ///
  /// Na deze deadline kan alleen een eigenaar wijzigingen
  /// uitvoeren.
  /// -----------------------------------------------------

  beschikbaarheidDeadline DateTime?

  vestiging Vestiging @relation(fields: [vestigingId], references: [id], onDelete: Cascade)

  diensten Dienst[]
  beschikbaarheden Beschikbaarheid[]

  aangemaaktOp DateTime @default(now())
  gewijzigdOp DateTime @updatedAt

  @@unique([vestigingId, jaar, weeknummer])

  @@index([vestigingId])
  @@index([jaar, weeknummer])
  @@index([status])
  @@index([beschikbaarheidDeadline])
}

/// ======================================================
/// BESCHIKBAARHEID
///
/// De medewerker geeft hiermee aan wanneer hij/zij
/// beschikbaar is.
///
/// Beschikbaarheid is nadrukkelijk geen planning.
/// De organisatie gebruikt deze gegevens bij het
/// samenstellen van de definitieve planning.
///
/// Tot de deadline mag de medewerker de eigen
/// beschikbaarheid toevoegen, wijzigen en verwijderen.
/// Na de deadline is wijziging alleen toegestaan voor
/// een eigenaar.
/// ======================================================

model Beschikbaarheid {
  id String @id @default(cuid())

  weekId String
  medewerkerId String

  datum DateTime

  begintijd DateTime
  eindtijd DateTime

  /// BESCHIKBAAR
  /// NIET_BESCHIKBAAR
  /// VOORKEUR
  status String @default("BESCHIKBAAR")

  opmerking String?

  week Week @relation(fields: [weekId], references: [id], onDelete: Cascade)
  medewerker Medewerker @relation(fields: [medewerkerId], references: [id], onDelete: Cascade)

  aangemaaktOp DateTime @default(now())
  gewijzigdOp DateTime @updatedAt

  @@index([weekId])
  @@index([medewerkerId])
  @@index([datum])
  @@index([status])
}

/// ======================================================
/// DIENST
/// ======================================================

model Dienst {
  id String @id @default(cuid())

  weekId String

  datum DateTime

  begintijd DateTime
  eindtijd DateTime

  opmerkingen String?

  week Week @relation(fields: [weekId], references: [id], onDelete: Cascade)

  tags DienstTag[]
  bezetting DienstBezetting[]

  aangemaaktOp DateTime @default(now())
  gewijzigdOp DateTime @updatedAt

  @@index([weekId])
  @@index([datum])
}

/// ======================================================
/// DIENST - TAG
///
/// Geeft aan welke kwaliteiten/functies voor een dienst
/// nodig zijn en hoeveel medewerkers daarvan nodig zijn.
/// ======================================================

model DienstTag {
  id String @id @default(cuid())

  dienstId String
  tagId String

  aantal Int @default(1)

  dienst Dienst @relation(fields: [dienstId], references: [id], onDelete: Cascade)
  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([dienstId, tagId])

  @@index([dienstId])
  @@index([tagId])
}

/// ======================================================
/// DIENST - BEZETTING
///
/// Dit is de daadwerkelijke planning.
///
/// medewerkerId blijft optioneel zodat een open
/// dienstplek kan bestaan voordat deze wordt ingevuld.
/// ======================================================

model DienstBezetting {
  id String @id @default(cuid())

  dienstId String

  medewerkerId String?

  /// OPEN
  /// GEPLAND
  /// BEVESTIGD
  /// AFGEZEGD
  /// GEWERKT
  status String @default("OPEN")

  dienst Dienst @relation(fields: [dienstId], references: [id], onDelete: Cascade)
  medewerker Medewerker? @relation(fields: [medewerkerId], references: [id], onDelete: SetNull)

  aangemaaktOp DateTime @default(now())
  gewijzigdOp DateTime @updatedAt

  @@index([dienstId])
  @@index([medewerkerId])
  @@index([status])

  @@unique([dienstId, medewerkerId])
}

/// ======================================================
/// PRODUCTEN
/// ======================================================

model ProductType {
  id String @id @default(cuid())

  code String @unique

  naam String

  volgorde Int

  actief Boolean @default(true)

  producten Product[]

  aangemaaktOp DateTime @default(now())
  gewijzigdOp DateTime @updatedAt

  @@index([volgorde])
  @@index([actief])
}

model Product {
  id String @id @default(cuid())

  code String @unique

  naam String

  productTypeId String

  actief Boolean @default(true)

  volgorde Int

  leverancier String?

  artikelnummer String?

  bestelEenheid String?

  voorraadEenheid String?

  productType ProductType @relation(fields: [productTypeId], references: [id], onDelete: Restrict)

  vestigingen VestigingProduct[]
  bestelRegels BestelRegel[]

voorraadTellingen VoorraadTellingRegel[]

voorraadMutaties VoorraadMutatie[]

leveringen LeveringRegel[]

  aangemaaktOp DateTime @default(now())
  gewijzigdOp DateTime @updatedAt

  @@index([naam])
  @@index([actief])
  @@index([volgorde])
}

model VestigingProduct {
  id String @id @default(cuid())

  vestigingId String
  productId String

  minimumVoorraad Decimal? @db.Decimal(10,2)

  bufferVoorraad Decimal? @db.Decimal(10,2)

  standaardBestelling Decimal? @db.Decimal(10,2)

  actief Boolean @default(true)

  vestiging Vestiging @relation(fields: [vestigingId], references: [id], onDelete: Cascade)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([vestigingId, productId])

  @@index([vestigingId])
  @@index([productId])
}

/// ======================================================
/// BESTELLINGEN
/// ======================================================

model Bestelling {
  id String @id @default(cuid())

  vestigingId String

  besteldatum DateTime

  leverdatum DateTime?

  statusId String

  opmerkingen String?

  vestiging Vestiging @relation(fields: [vestigingId], references: [id], onDelete: Cascade)

  status Status @relation(fields: [statusId], references: [id], onDelete: Restrict)

  regels BestelRegel[]
  leveringen Levering[]

  aangemaaktOp DateTime @default(now())
  gewijzigdOp DateTime @updatedAt

  @@index([vestigingId])
  @@index([besteldatum])
  @@index([statusId])
}

model BestelRegel {
  id String @id @default(cuid())

  bestellingId String
  productId String

  adviesAantal Decimal @db.Decimal(10,2)

  besteldAantal Decimal @db.Decimal(10,2)

  geleverdAantal Decimal? @db.Decimal(10,2)

  bestelling Bestelling @relation(fields: [bestellingId], references: [id], onDelete: Cascade)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([bestellingId, productId])

  @@index([bestellingId])
  @@index([productId])
}

/// ======================================================
/// VOORRAAD
/// ======================================================

model VoorraadTelling {
  id String @id @default(cuid())

  vestigingId String

  teldatum DateTime

  statusId String

  opmerkingen String?

  vestiging Vestiging @relation(fields: [vestigingId], references: [id], onDelete: Cascade)

  status Status @relation(fields: [statusId], references: [id], onDelete: Restrict)

  regels VoorraadTellingRegel[]

  aangemaaktOp DateTime @default(now())
  gewijzigdOp DateTime @updatedAt

  @@index([vestigingId])
  @@index([teldatum])
}

model VoorraadTellingRegel {
  id String @id @default(cuid())

  tellingId String

  productId String

  geteld Decimal @db.Decimal(10,2)

  advies Decimal? @db.Decimal(10,2)

  bestelling Decimal? @db.Decimal(10,2)

  telling VoorraadTelling @relation(fields: [tellingId], references: [id], onDelete: Cascade)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([tellingId, productId])

  @@index([tellingId])
  @@index([productId])
}

model VoorraadMutatie {
  id String @id @default(cuid())

  vestigingId String

  productId String

  aantal Decimal @db.Decimal(10,2)

  reden String

  referentie String?

  opmerkingen String?

  vestiging Vestiging @relation(fields: [vestigingId], references: [id], onDelete: Cascade)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  aangemaaktOp DateTime @default(now())

  @@index([vestigingId])
  @@index([productId])
}

/// ======================================================
/// LEVERINGEN
/// ======================================================

model Levering {
  id String @id @default(cuid())

  bestellingId String

  leverdatum DateTime

  pakbonNummer String?

  opmerkingen String?

  bestelling Bestelling @relation(fields: [bestellingId], references: [id], onDelete: Restrict)

  regels LeveringRegel[]

  aangemaaktOp DateTime @default(now())
  gewijzigdOp DateTime @updatedAt

  @@index([leverdatum])
}

model LeveringRegel {
  id String @id @default(cuid())

  leveringId String
  productId String

  besteld Decimal @db.Decimal(10,2)

  geleverd Decimal @db.Decimal(10,2)

  levering Levering @relation(fields: [leveringId], references: [id], onDelete: Cascade)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([leveringId, productId])

  @@index([leveringId])
  @@index([productId])
}

/// ======================================================
/// INSTELLINGEN
/// ======================================================

model Status {
  id String @id @default(cuid())

  /// =====================================================
  /// Algemeen
  /// =====================================================

  module String

  code String

  naam String

  omschrijving String?

  /// =====================================================
  /// Weergave
  /// =====================================================

  kleur String?

  icoon String?

  cssClass String?

  volgorde Int @default(0)

  actief Boolean @default(true)

  /// =====================================================
  /// Relaties
  /// =====================================================

  medewerkers Medewerker[]

  bestellingen Bestelling[]

  voorraadTellingen VoorraadTelling[]

  /// =====================================================
  /// Audit
  /// =====================================================

  aangemaaktOp DateTime @default(now())
  gewijzigdOp DateTime @updatedAt

  @@unique([module, code])

  @@index([module])
  @@index([actief])
  @@index([volgorde])
}

model Instelling {
  id String @id @default(cuid())

  sleutel String @unique

  waarde String

  omschrijving String?

  categorie String?

  aangemaaktOp DateTime @default(now())
  gewijzigdOp DateTime @updatedAt

  @@index([categorie])
}



