generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organisatie {
  id             String                 @id @default(cuid())
  code           String                 @unique
  naam           String                 @unique
  actief         Boolean                @default(true)
  aangemaaktOp   DateTime               @default(now())
  gewijzigdOp    DateTime               @updatedAt
  aangemaaktDoor String?
  gewijzigdDoor  String?
  gebruikers     OrganisatieGebruiker[]
  vestigingen    Vestiging[]

  @@index([actief])
}

model Vestiging {
  id                 String                      @id @default(cuid())
  organisatieId      String
  code               String
  naam               String
  actief             Boolean                     @default(true)
  aangemaaktOp       DateTime                    @default(now())
  gewijzigdOp        DateTime                    @updatedAt
  aangemaaktDoor     String?
  gewijzigdDoor      String?
  seizoenEinde       DateTime?
  /// -----------------------------------------------------
  /// SEIZOEN
  ///
  /// Bepaalt de periode waarin de personeelsplanning
  /// actief is.
  ///
  /// Binnen deze periode worden automatisch
  /// planningweken aangemaakt.
  ///
  /// Buiten deze periode worden planningweken
  /// automatisch afgesloten.
  /// -----------------------------------------------------
  seizoenStart       DateTime?
  bestellingen       Bestelling[]
  medewerkers        MedewerkerVestiging[]
  openingstijden     OpeningstijdenPeriode[]
  vestigingToegang   SysteemGebruikerVestiging[]
  urenregistraties   UrenRegistratie[]
  vakantieAanvragen  VakantieAanvraag[]
  verloningsRegels   VerloningsRegel[]
  organisatie        Organisatie                 @relation(fields: [organisatieId], references: [id], onDelete: Cascade)
  vestigingProducten VestigingProduct[]
  voorraadMutaties   VoorraadMutatie[]
  voorraadTellingen  VoorraadTelling[]
  weken              Week[]

  @@unique([organisatieId, code])
  @@unique([organisatieId, naam])
  @@index([organisatieId])
  @@index([actief])
  @@index([seizoenStart])
  @@index([seizoenEinde])
}

model OpeningstijdenPeriode {
  id            String    @id @default(cuid())
  vestigingId   String
  startDatum    DateTime
  eindDatum     DateTime
  openingstijd  String
  sluitingstijd String
  aangemaaktOp  DateTime  @default(now())
  gewijzigdOp   DateTime  @updatedAt
  vestiging     Vestiging @relation(fields: [vestigingId], references: [id], onDelete: Cascade)

  @@index([vestigingId])
  @@index([vestigingId, startDatum, eindDatum])
}

model OrganisatieGebruiker {
  id                 String           @id @default(cuid())
  organisatieId      String
  systeemGebruikerId String
  rolId              String
  actief             Boolean          @default(true)
  aangemaaktOp       DateTime         @default(now())
  gewijzigdOp        DateTime         @updatedAt
  organisatie        Organisatie      @relation(fields: [organisatieId], references: [id], onDelete: Cascade)
  rol                Rol              @relation(fields: [rolId], references: [id])
  systeemGebruiker   SysteemGebruiker @relation(fields: [systeemGebruikerId], references: [id], onDelete: Cascade)

  @@unique([organisatieId, systeemGebruikerId])
  @@index([systeemGebruikerId])
  @@index([organisatieId])
  @@index([rolId])
  @@index([organisatieId, actief])
}

model SysteemGebruiker {
  id               String                      @id @default(cuid())
  naam             String
  email            String                      @unique
  wachtwoordHash   String
  actief           Boolean                     @default(true)
  laatsteLoginOp   DateTime?
  aangemaaktOp     DateTime                    @default(now())
  gewijzigdOp      DateTime                    @updatedAt
  auditLogs        AuditLog[]
  medewerker       Medewerker?
  organisaties     OrganisatieGebruiker[]
  vestigingToegang SysteemGebruikerVestiging[]

  @@index([actief])
}

model SysteemGebruikerVestiging {
  id                 String           @id @default(cuid())
  systeemGebruikerId String
  vestigingId        String
  actief             Boolean          @default(true)
  aangemaaktOp       DateTime         @default(now())
  gewijzigdOp        DateTime         @updatedAt
  systeemGebruiker   SysteemGebruiker @relation(fields: [systeemGebruikerId], references: [id], onDelete: Cascade)
  vestiging          Vestiging        @relation(fields: [vestigingId], references: [id], onDelete: Cascade)

  @@unique([systeemGebruikerId, vestigingId])
  @@index([systeemGebruikerId])
  @@index([vestigingId])
  @@index([vestigingId, actief])
}

model Rol {
  id                    String                 @id @default(cuid())
  naam                  String                 @unique
  omschrijving          String?
  aangemaaktOp          DateTime               @default(now())
  gewijzigdOp           DateTime               @updatedAt
  medewerkerRollen      MedewerkerRol[]
  organisatieGebruikers OrganisatieGebruiker[]
}

model AuditLog {
  id                 String            @id @default(cuid())
  systeemGebruikerId String?
  module             String
  actie              String
  recordId           String?
  details            Json?
  aangemaaktOp       DateTime          @default(now())
  systeemGebruiker   SysteemGebruiker? @relation(fields: [systeemGebruikerId], references: [id])

  @@index([module])
  @@index([aangemaaktOp])
}

model Medewerker {
  id                       String                @id @default(cuid())
  systeemGebruikerId       String?               @unique
  personeelsnummer         String?               @unique
  aanhef                   Aanhef
  voornaam                 String
  tussenvoegsel            String?
  achternaam               String
  roepnaam                 String?
  geboortedatum            DateTime
  email                    String                @unique
  telefoon                 String
  statusId                 String
  aanmeldingOp             DateTime              @default(now())
  geactiveerdOp            DateTime?
  geactiveerdDoor          String?
  actief                   Boolean               @default(false)
  contractType             ContractType?
  contractUren             Decimal?              @db.Decimal(5, 2)
  datumInDienst            DateTime?
  datumUitDienst           DateTime?
  /// ----------------------------------------------------
  /// AUDIT
  /// ----------------------------------------------------
  aangemaaktOp             DateTime              @default(now())
  gewijzigdOp              DateTime              @updatedAt
  uurloon                  Decimal?              @db.Decimal(8, 2)
  beschikbaarheden         Beschikbaarheid[]
  diensten                 DienstBezetting[]
  status                   Status                @relation(fields: [statusId], references: [id])
  systeemGebruiker         SysteemGebruiker?     @relation(fields: [systeemGebruikerId], references: [id])
  rollen                   MedewerkerRol[]
  tags                     MedewerkerTag[]
  vestigingen              MedewerkerVestiging[]
  ruilverzoekenAangevraagd Ruilverzoek[]         @relation("RuilverzoekenAangevraagd")
  ruilverzoekenOntvangen   Ruilverzoek[]         @relation("RuilverzoekenOntvangen")
  urenregistraties         UrenRegistratie[]
  vakantieAanvragen        VakantieAanvraag[]
  verloningsRegels         VerloningsRegel[]

  @@index([statusId])
  @@index([actief])
  @@index([achternaam])
  @@index([voornaam])
}

model MedewerkerVestiging {
  id             String     @id @default(cuid())
  medewerkerId   String
  vestigingId    String
  hoofdvestiging Boolean    @default(false)
  aangemaaktOp   DateTime   @default(now())
  medewerker     Medewerker @relation(fields: [medewerkerId], references: [id], onDelete: Cascade)
  vestiging      Vestiging  @relation(fields: [vestigingId], references: [id], onDelete: Cascade)

  @@unique([medewerkerId, vestigingId])
  @@index([medewerkerId])
  @@index([vestigingId])
}

model MedewerkerRol {
  id           String     @id @default(cuid())
  medewerkerId String
  rolId        String
  aangemaaktOp DateTime   @default(now())
  medewerker   Medewerker @relation(fields: [medewerkerId], references: [id], onDelete: Cascade)
  rol          Rol        @relation(fields: [rolId], references: [id], onDelete: Cascade)

  @@unique([medewerkerId, rolId])
  @@index([medewerkerId])
  @@index([rolId])
}

model Tag {
  id           String          @id @default(cuid())
  naam         String          @unique
  volgorde     Int             @default(0)
  actief       Boolean         @default(true)
  aangemaaktOp DateTime        @default(now())
  gewijzigdOp  DateTime        @updatedAt
  diensten     DienstTag[]
  medewerkers  MedewerkerTag[]

  @@index([volgorde])
  @@index([actief])
}

model MedewerkerTag {
  id           String     @id @default(cuid())
  medewerkerId String
  tagId        String
  medewerker   Medewerker @relation(fields: [medewerkerId], references: [id], onDelete: Cascade)
  tag          Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([medewerkerId, tagId])
  @@index([medewerkerId])
  @@index([tagId])
}

model Week {
  id                      String            @id @default(cuid())
  vestigingId             String
  jaar                    Int
  weeknummer              Int
  /// -----------------------------------------------------
  /// Status
  ///
  /// OPEN
  /// IN_PLANNING
  /// GEPUBLICEERD
  /// AFGESLOTEN
  /// -----------------------------------------------------
  status                  String            @default("OPEN")
  /// -----------------------------------------------------
  /// Beschikbaarheidsdeadline
  ///
  /// Uiterste moment waarop medewerkers hun
  /// beschikbaarheid voor deze week kunnen doorgeven.
  ///
  /// De daadwerkelijke deadline wordt per week
  /// opgeslagen zodat historische weken hun oorspronkelijke
  /// deadline behouden.
  /// -----------------------------------------------------
  beschikbaarheidDeadline DateTime?
  aangemaaktOp            DateTime          @default(now())
  gewijzigdOp             DateTime          @updatedAt
  beschikbaarheden        Beschikbaarheid[]
  diensten                Dienst[]
  vestiging               Vestiging         @relation(fields: [vestigingId], references: [id], onDelete: Cascade)

  @@unique([vestigingId, jaar, weeknummer])
  @@index([vestigingId])
  @@index([jaar, weeknummer])
  @@index([status])
  @@index([beschikbaarheidDeadline])
}

model Beschikbaarheid {
  id           String     @id @default(cuid())
  weekId       String
  medewerkerId String
  datum        DateTime
  begintijd    DateTime
  eindtijd     DateTime
  /// -----------------------------------------------------
  /// Beschikbaarheidsstatus
  ///
  /// BESCHIKBAAR
  /// NIET_BESCHIKBAAR
  /// VOORKEUR
  /// -----------------------------------------------------
  status       String     @default("BESCHIKBAAR")
  opmerking    String?
  aangemaaktOp DateTime   @default(now())
  gewijzigdOp  DateTime   @updatedAt
  medewerker   Medewerker @relation(fields: [medewerkerId], references: [id], onDelete: Cascade)
  week         Week       @relation(fields: [weekId], references: [id], onDelete: Cascade)

  @@index([weekId])
  @@index([medewerkerId])
  @@index([datum])
  @@index([status])
}

model VakantieAanvraag {
  id               String     @id @default(cuid())
  medewerkerId     String
  vestigingId      String
  startDatum       DateTime
  eindDatum        DateTime
  /// -----------------------------------------------------
  /// Type afwezigheid
  ///
  /// VAKANTIE
  /// OVERIG
  /// -----------------------------------------------------
  type             String     @default("VAKANTIE")
  opmerking        String?
  /// -----------------------------------------------------
  /// Status
  ///
  /// AANGEVRAAGD
  /// GOEDGEKEURD
  /// AFGEWEZEN
  /// GEANNULEERD
  /// -----------------------------------------------------
  status           String     @default("AANGEVRAAGD")
  /// -----------------------------------------------------
  /// Beoordeling door eigenaar
  /// -----------------------------------------------------
  beoordeeldDoorId String?
  beoordeeldOp     DateTime?
  redenAfwijzing   String?
  aangevraagdOp    DateTime   @default(now())
  aangemaaktOp     DateTime   @default(now())
  gewijzigdOp      DateTime   @updatedAt
  medewerker       Medewerker @relation(fields: [medewerkerId], references: [id], onDelete: Cascade)
  vestiging        Vestiging  @relation(fields: [vestigingId], references: [id])

  @@index([medewerkerId])
  @@index([vestigingId])
  @@index([startDatum])
  @@index([eindDatum])
  @@index([status])
  @@index([beoordeeldDoorId])
}

model Dienst {
  id           String            @id @default(cuid())
  weekId       String
  datum        DateTime
  begintijd    DateTime
  eindtijd     DateTime
  opmerkingen  String?
  aangemaaktOp DateTime          @default(now())
  gewijzigdOp  DateTime          @updatedAt
  week         Week              @relation(fields: [weekId], references: [id], onDelete: Cascade)
  bezetting    DienstBezetting[]
  tags         DienstTag[]

  @@index([weekId])
  @@index([datum])
}

model DienstTag {
  id       String @id @default(cuid())
  dienstId String
  tagId    String
  aantal   Int    @default(1)
  dienst   Dienst @relation(fields: [dienstId], references: [id], onDelete: Cascade)
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([dienstId, tagId])
  @@index([dienstId])
  @@index([tagId])
}

model DienstBezetting {
  id              String           @id @default(cuid())
  dienstId        String
  medewerkerId    String?
  status          String           @default("OPEN")
  aangemaaktOp    DateTime         @default(now())
  gewijzigdOp     DateTime         @updatedAt
  dienst          Dienst           @relation(fields: [dienstId], references: [id], onDelete: Cascade)
  medewerker      Medewerker?      @relation(fields: [medewerkerId], references: [id])
  ruilverzoeken   Ruilverzoek[]
  urenregistratie UrenRegistratie?

  @@unique([dienstId, medewerkerId])
  @@index([dienstId])
  @@index([medewerkerId])
  @@index([status])
}

model Ruilverzoek {
  id                       String          @id @default(cuid())
  dienstBezettingId        String
  /// Medewerker die de ruil aanvraagt.
  aanvragerId              String
  /// Medewerker die de dienst moet overnemen.
  ruilMedewerkerId         String
  /// -----------------------------------------------------
  /// Ruilstatus
  ///
  /// AANGEVRAAGD
  /// AFGEWEZEN_DOOR_MEDEWERKER
  /// WACHT_OP_EIGENAAR
  /// AFGEWEZEN_DOOR_EIGENAAR
  /// GOEDGEKEURD
  /// UITGEVOERD
  /// -----------------------------------------------------
  status                   String          @default("AANGEVRAAGD")
  aangevraagdOp            DateTime        @default(now())
  medewerkerGeaccepteerdOp DateTime?
  /// ID van de systeemgebruiker/eigenaar die de ruil
  /// heeft beoordeeld.
  ///
  /// Bewust alleen als ID opgeslagen. Hierdoor is voor
  /// deze relatie geen wijziging in SysteemGebruiker nodig.
  eigenaarBeoordeeldDoorId String?
  eigenaarBeoordeeldOp     DateTime?
  uitgevoerdOp             DateTime?
  aangemaaktOp             DateTime        @default(now())
  gewijzigdOp              DateTime        @updatedAt
  aanvrager                Medewerker      @relation("RuilverzoekenAangevraagd", fields: [aanvragerId], references: [id], onDelete: Cascade)
  dienstBezetting          DienstBezetting @relation(fields: [dienstBezettingId], references: [id], onDelete: Cascade)
  ruilMedewerker           Medewerker      @relation("RuilverzoekenOntvangen", fields: [ruilMedewerkerId], references: [id], onDelete: Cascade)

  @@index([dienstBezettingId])
  @@index([aanvragerId])
  @@index([ruilMedewerkerId])
  @@index([status])
  @@index([eigenaarBeoordeeldDoorId])
}

model UrenRegistratie {
  id                  String          @id @default(cuid())
  dienstBezettingId   String          @unique
  medewerkerId        String
  /// Vestiging wordt bewust als ID opgeslagen zodat de
  /// definitieve registratie altijd aan de betreffende
  /// vestiging gekoppeld blijft.
  vestigingId         String
  datum               DateTime
  /// Taak/functie waarvoor de medewerker heeft gewerkt.
  taak                String?
  /// Werkelijke gewerkte tijden.
  werkelijkeBegintijd DateTime
  werkelijkeEindtijd  DateTime
  /// Pauze in minuten.
  pauzeMinuten        Int             @default(0)
  /// Definitief berekende gewerkte uren.
  gewerkteUren        Decimal         @db.Decimal(5, 2)
  /// -----------------------------------------------------
  /// Status
  ///
  /// TE_CONTROLEREN
  /// DEFINITIEF
  /// AFGEKEURD
  /// -----------------------------------------------------
  status              String          @default("TE_CONTROLEREN")
  /// Systeemgebruiker die de uren heeft gecontroleerd.
  gecontroleerdDoorId String?
  gecontroleerdOp     DateTime?
  opmerking           String?
  aangemaaktOp        DateTime        @default(now())
  gewijzigdOp         DateTime        @updatedAt
  dienstBezetting     DienstBezetting @relation(fields: [dienstBezettingId], references: [id], onDelete: Cascade)
  medewerker          Medewerker      @relation(fields: [medewerkerId], references: [id], onDelete: Cascade)
  vestiging           Vestiging       @relation(fields: [vestigingId], references: [id])

  @@index([medewerkerId])
  @@index([vestigingId])
  @@index([datum])
  @@index([status])
  @@index([gecontroleerdDoorId])
}

model ProductType {
  id           String    @id @default(cuid())
  code         String    @unique
  naam         String
  volgorde     Int
  actief       Boolean   @default(true)
  aangemaaktOp DateTime  @default(now())
  gewijzigdOp  DateTime  @updatedAt
  producten    Product[]

  @@index([volgorde])
  @@index([actief])
}

model Product {
  id                String                 @id @default(cuid())
  code              String                 @unique
  naam              String
  productTypeId     String
  actief            Boolean                @default(true)
  volgorde          Int
  leverancier       String?
  artikelnummer     String?
  bestelEenheid     String?
  voorraadEenheid   String?
  aangemaaktOp      DateTime               @default(now())
  gewijzigdOp       DateTime               @updatedAt
  bestelRegels      BestelRegel[]
  leveringen        LeveringRegel[]
  productType       ProductType            @relation(fields: [productTypeId], references: [id])
  vestigingen       VestigingProduct[]
  voorraadMutaties  VoorraadMutatie[]
  voorraadTellingen VoorraadTellingRegel[]

  @@index([naam])
  @@index([actief])
  @@index([volgorde])
}

model VestigingProduct {
  id                  String    @id @default(cuid())
  vestigingId         String
  productId           String
  minimumVoorraad     Decimal?  @db.Decimal(10, 2)
  bufferVoorraad      Decimal?  @db.Decimal(10, 2)
  standaardBestelling Decimal?  @db.Decimal(10, 2)
  actief              Boolean   @default(true)
  product             Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  vestiging           Vestiging @relation(fields: [vestigingId], references: [id], onDelete: Cascade)

  @@unique([vestigingId, productId])
  @@index([vestigingId])
  @@index([productId])
}

model Bestelling {
  id           String        @id @default(cuid())
  vestigingId  String
  besteldatum  DateTime
  leverdatum   DateTime?
  statusId     String
  opmerkingen  String?
  aangemaaktOp DateTime      @default(now())
  gewijzigdOp  DateTime      @updatedAt
  regels       BestelRegel[]
  status       Status        @relation(fields: [statusId], references: [id])
  vestiging    Vestiging     @relation(fields: [vestigingId], references: [id], onDelete: Cascade)
  leveringen   Levering[]

  @@index([vestigingId])
  @@index([besteldatum])
  @@index([statusId])
}

model BestelRegel {
  id             String     @id @default(cuid())
  bestellingId   String
  productId      String
  adviesAantal   Decimal    @db.Decimal(10, 2)
  besteldAantal  Decimal    @db.Decimal(10, 2)
  geleverdAantal Decimal?   @db.Decimal(10, 2)
  bestelling     Bestelling @relation(fields: [bestellingId], references: [id], onDelete: Cascade)
  product        Product    @relation(fields: [productId], references: [id])

  @@unique([bestellingId, productId])
  @@index([bestellingId])
  @@index([productId])
}

model VoorraadTelling {
  id           String                 @id @default(cuid())
  vestigingId  String
  teldatum     DateTime
  statusId     String
  opmerkingen  String?
  aangemaaktOp DateTime               @default(now())
  gewijzigdOp  DateTime               @updatedAt
  status       Status                 @relation(fields: [statusId], references: [id])
  vestiging    Vestiging              @relation(fields: [vestigingId], references: [id], onDelete: Cascade)
  regels       VoorraadTellingRegel[]

  @@index([vestigingId])
  @@index([teldatum])
}

model VoorraadTellingRegel {
  id         String          @id @default(cuid())
  tellingId  String
  productId  String
  geteld     Decimal         @db.Decimal(10, 2)
  advies     Decimal?        @db.Decimal(10, 2)
  bestelling Decimal?        @db.Decimal(10, 2)
  product    Product         @relation(fields: [productId], references: [id])
  telling    VoorraadTelling @relation(fields: [tellingId], references: [id], onDelete: Cascade)

  @@unique([tellingId, productId])
  @@index([tellingId])
  @@index([productId])
}

model VoorraadMutatie {
  id           String    @id @default(cuid())
  vestigingId  String
  productId    String
  aantal       Decimal   @db.Decimal(10, 2)
  reden        String
  referentie   String?
  opmerkingen  String?
  aangemaaktOp DateTime  @default(now())
  product      Product   @relation(fields: [productId], references: [id])
  vestiging    Vestiging @relation(fields: [vestigingId], references: [id], onDelete: Cascade)

  @@index([vestigingId])
  @@index([productId])
}

model Levering {
  id           String          @id @default(cuid())
  bestellingId String
  leverdatum   DateTime
  pakbonNummer String?
  opmerkingen  String?
  aangemaaktOp DateTime        @default(now())
  gewijzigdOp  DateTime        @updatedAt
  bestelling   Bestelling      @relation(fields: [bestellingId], references: [id])
  regels       LeveringRegel[]

  @@index([leverdatum])
}

model LeveringRegel {
  id         String   @id @default(cuid())
  leveringId String
  productId  String
  besteld    Decimal  @db.Decimal(10, 2)
  geleverd   Decimal  @db.Decimal(10, 2)
  levering   Levering @relation(fields: [leveringId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])

  @@unique([leveringId, productId])
  @@index([leveringId])
  @@index([productId])
}

model Status {
  id                String            @id @default(cuid())
  /// =====================================================
  /// Algemeen
  /// =====================================================
  module            String
  code              String
  naam              String
  omschrijving      String?
  /// =====================================================
  /// Weergave
  /// =====================================================
  kleur             String?
  icoon             String?
  cssClass          String?
  volgorde          Int               @default(0)
  actief            Boolean           @default(true)
  /// =====================================================
  /// Audit
  /// =====================================================
  aangemaaktOp      DateTime          @default(now())
  gewijzigdOp       DateTime          @updatedAt
  bestellingen      Bestelling[]
  medewerkers       Medewerker[]
  voorraadTellingen VoorraadTelling[]

  @@unique([module, code])
  @@index([module])
  @@index([actief])
  @@index([volgorde])
}

model Instelling {
  id           String   @id @default(cuid())
  sleutel      String   @unique
  waarde       String
  omschrijving String?
  categorie    String?
  aangemaaktOp DateTime @default(now())
  gewijzigdOp  DateTime @updatedAt

  @@index([categorie])
}

model VerloningsPeriode {
  id                  String            @id @default(cuid())
  /// ----------------------------------------------------
  /// VERLONINGSPERIODE
  /// ----------------------------------------------------
  periodeStart        DateTime
  periodeEinde        DateTime
  jaar                Int
  maand               Int
  /// AANGEMAAKT
  /// KLAAR
  /// VERWERKT
  status              String            @default("AANGEMAAKT")
  /// Moment waarop de verloningsperiode is gegenereerd.
  gegenereerdOp       DateTime?
  /// Systeemgebruiker die de volledige
  /// verloningsperiode heeft gecontroleerd.
  gecontroleerdDoorId String?
  /// Moment waarop de eigenaar de volledige
  /// verloningsperiode heeft gecontroleerd.
  gecontroleerdOp     DateTime?
  /// ----------------------------------------------------
  /// AUDIT
  /// ----------------------------------------------------
  aangemaaktOp        DateTime          @default(now())
  gewijzigdOp         DateTime          @updatedAt
  regels              VerloningsRegel[]

  @@unique([jaar, maand])
  @@index([jaar, maand])
  @@index([status])
  @@index([periodeStart])
  @@index([periodeEinde])
}

model VerloningsRegel {
  id                  String            @id @default(cuid())
  /// ----------------------------------------------------
  /// RELATIES
  /// ----------------------------------------------------
  verloningsPeriodeId String
  medewerkerId        String
  vestigingId         String
  /// Snapshot van de naam op het moment waarop de
  /// maandrapportage wordt gegenereerd.
  medewerkerNaam      String
  /// ----------------------------------------------------
  /// TOTALEN
  /// ----------------------------------------------------
  gewerkteDagen       Int               @default(0)
  gewerkteUren        Decimal           @db.Decimal(7, 2)
  /// ----------------------------------------------------
  /// AUDIT
  /// ----------------------------------------------------
  aangemaaktOp        DateTime          @default(now())
  gewijzigdOp         DateTime          @updatedAt
  medewerker          Medewerker        @relation(fields: [medewerkerId], references: [id])
  verloningsPeriode   VerloningsPeriode @relation(fields: [verloningsPeriodeId], references: [id], onDelete: Cascade)
  vestiging           Vestiging         @relation(fields: [vestigingId], references: [id])

  @@unique([verloningsPeriodeId, medewerkerId, vestigingId])
  @@index([verloningsPeriodeId])
  @@index([medewerkerId])
  @@index([vestigingId])
  @@index([vestigingId, medewerkerNaam])
}

enum Aanhef {
  DHR
  MEVR
  ANDERS
  GEEN_OPGAVE
}

enum ContractType {
  OPROEP
  VAST
}
