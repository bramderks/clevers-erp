{
  "name": "clevers-erp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run prisma:generate && prisma migrate deploy && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "seed": "tsx prisma/seed.ts",
    "prisma:merge": "node prisma/merge-schema.mjs",
    "prisma:generate": "npm run prisma:merge && prisma generate",
    "prisma:validate": "npm run prisma:merge && prisma validate",
    "prisma:push": "npm run prisma:merge && prisma db push",
    "prisma:seed": "npm run prisma:push && npm run seed",
    "prisma:reset": "npm run prisma:push && npm run seed",
    "prisma:check": "npm run prisma:generate && npm run typecheck",
    "dev:sync": "npm run prisma:push && prisma generate && npm run seed && npm run typecheck",
    "dev:check": "npm run prisma:push && prisma generate && npm run seed && npm run build"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "jose": "^6.2.8",
    "lucide-react": "^1.30.0",
    "next": "16.3.3",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.65.0",
    "tailwind-merge": "^3.6.0",
    "web-push": "^3.6.7",
    "xlsx": "npm:@stackline/xlsx@1.0.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.10",
    "typescript": "^5"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "fast-uri": "3.1.7",
    "mysql2": "3.23.2",
    "nanoid": "3.3.18",
    "sharp": "0.35.4"
  }
}
